# Server
NODE_ENV=development
PORT=3000
HOST=localhost

# Database
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=claude_harness
DB_USER=postgres
DB_PASSWORD=password

# Claude API
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MAX_CONCURRENT=10
CLAUDE_TIMEOUT=600000

# WebSocket
WS_PORT=3001

# JWT Authentication
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
